{
  "expo": {
    "name": "JunqLife",
    "slug": "junqlife",
    "version": "0.1.17",
    "icon": "./assets/brand/junqlife-icon.png",
    "orientation": "portrait",
    "scheme": "junqlife",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.junq.junqlife",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O JunqLife usa sua localização para compartilhar sua posição com os círculos que você ativar.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O JunqLife usa localização em segundo plano enquanto o rastreamento estiver ligado.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.junq.junqlife",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 18
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/junqlife-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6d31c547-2f24-4f53-8ed2-12ab2bac97a7"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      "expo-dev-client",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.3.20",
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "./plugins/withKotlinCompiler"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/JunqLife"
    }
  }
}
