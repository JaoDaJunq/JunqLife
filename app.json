{
  "expo": {
    "name": "JunqLife",
    "slug": "junqlife",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "junqlife",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.junq.junqlife"
    },
    "android": {
      "package": "com.junq.junqlife",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
